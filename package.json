{
  "name": "qwenimage3-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "prebuild": "node scripts/db-setup.mjs",
    "build": "vite build",
    "i18n:validate": "node scripts/validate-locales.mjs",
    "prevercel:build": "tsx scripts/validate-production-config.ts && node scripts/db-setup.mjs && tsx scripts/ensure-referral-schema.ts && tsx scripts/ensure-content-safety-schema.ts && tsx scripts/ensure-account-status-schema.ts",
    "vercel:build": "NITRO_PRESET=vercel vite build",
    "start": "node .output/server/index.mjs",
    "precf:build": "node scripts/db-setup.mjs",
    "cf:build": "NITRO_PRESET=cloudflare_module vite build",
    "cf:deploy": "sh -c 'set -a && [ -f .env.production ] && . ./.env.production; set +a && pnpm cf:build && exec wrangler deploy'",
    "postinstall": "node scripts/db-setup.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:push": "tsx scripts/with-env.ts drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "tsx scripts/with-env.ts drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/with-env.ts drizzle-kit migrate --config=drizzle.config.ts",
    "db:referrals:ensure": "tsx scripts/ensure-referral-schema.ts",
    "db:studio": "tsx scripts/with-env.ts drizzle-kit studio --config=drizzle.config.ts",
    "test:credits": "tsx scripts/verify-credit-ledger.ts",
    "test:referrals": "tsx scripts/with-env.ts tsx scripts/verify-referral-purchase-reward.ts",
    "test:credit-migration": "tsx scripts/verify-credit-migration.ts",
    "test:prepaid": "tsx scripts/verify-prepaid-membership.ts",
    "test:models": "tsx scripts/verify-image-model-catalog.ts",
    "test:fal-qwen3": "tsx scripts/verify-fal-qwen3-provider.ts",
    "test:media-tools": "tsx scripts/verify-media-tools-provider.ts",
    "test:creative-studio": "tsx scripts/verify-creative-studio.ts",
    "test:public-pages": "tsx scripts/verify-public-creative-pages.ts",
    "test:public-creative": "tsx scripts/verify-public-creative-pages.ts",
    "test:gpt-image-opportunities": "tsx scripts/verify-gpt-image-opportunities.ts",
    "test:generation-feedback": "tsx scripts/with-env.ts tsx scripts/verify-generation-feedback.ts",
    "test:keyword-generators": "tsx scripts/verify-keyword-generators.ts",
    "test:admin-generations": "tsx scripts/with-env.ts tsx scripts/verify-admin-generations.ts",
    "test:fal-webhook": "tsx scripts/verify-fal-webhook-token.ts",
    "test:downloads": "tsx scripts/verify-image-download.ts",
    "test:auth-navigation": "tsx scripts/verify-auth-navigation.ts",
    "test:anonymous-rate-limit": "tsx scripts/verify-anonymous-rate-limit.ts",
    "test:content-safety": "tsx scripts/verify-content-safety.ts",
    "test:unsafe-image-ban": "tsx scripts/verify-unsafe-image-ban.ts",
    "test:account-status": "tsx scripts/with-env.ts tsx scripts/verify-account-status.ts",
    "test:output-safety": "tsx scripts/verify-output-moderation.ts",
    "test:analytics": "tsx scripts/verify-analytics-events.ts",
    "smoke:qwen3": "tsx scripts/with-env.ts tsx scripts/smoke-qwen-image-3-live.ts",
    "smoke:studio-fal": "tsx scripts/with-env.ts tsx scripts/smoke-creative-studio-fal-live.ts",
    "generate:seedance-demo": "tsx scripts/with-env.ts tsx scripts/generate-seedance-demo.ts",
    "check:qwen3": "tsx scripts/check-qwen-image-3-availability.ts",
    "rbac:init": "tsx scripts/with-env.ts tsx scripts/init-rbac.ts",
    "rbac:assign": "tsx scripts/with-env.ts tsx scripts/assign-role.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check .",
    "typecheck": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc --noEmit",
    "prepare": "husky",
    "db:safety:ensure": "tsx scripts/with-env.ts tsx scripts/ensure-content-safety-schema.ts",
    "db:account-status:ensure": "tsx scripts/with-env.ts tsx scripts/ensure-account-status-schema.ts",
    "db:generation-feedback:ensure": "tsx scripts/with-env.ts tsx scripts/ensure-generation-feedback-schema.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "prettier --write",
    "*.{json,css,md,mdx,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/libre-baskerville": "^5.2.10",
    "@libsql/client": "^0.14.0",
    "@mdx-js/react": "^3.1.1",
    "@react-email/components": "^1.0.0",
    "@sentry/tanstackstart-react": "10.66.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@types/mdx": "^2.0.13",
    "aws4fetch": "^1.0.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.511.0",
    "markdown-it": "^14.2.0",
    "motion": "^12.38.0",
    "mysql2": "^3.14.0",
    "nanoid": "^5.0.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "3.8.0",
    "replicate": "^1.0.0",
    "resend": "^4.0.0",
    "simple-flakeid": "^0.0.5",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@inlang/paraglide-js": "^2.18.2",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.2.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.16",
    "wrangler": "^4.98.0"
  },
  "pnpm": {
    "overrides": {
      "next": ">=16.2.6",
      "ws": ">=8.21.0",
      "qs": ">=6.15.2",
      "brace-expansion": ">=5.0.6",
      "js-yaml": ">=4.2.0",
      "linkify-it": "5.0.2",
      "esbuild": ">=0.28.1",
      "@babel/core": "7.29.7"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "msw",
      "sharp",
      "workerd"
    ]
  }
}
